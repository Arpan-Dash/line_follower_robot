<?xml version="1.0"?>
<robot name="line_follower" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find line_follower_bot)/description/materials.xacro"/>
  <xacro:include filename="$(find line_follower_bot)/description/camera.xacro"/>
  <xacro:property name="wheel_radius" value="0.055"/>
  <xacro:property name="wheel_width" value="0.035"/>
  <xacro:property name="wheel_separation" value="0.22"/>

  <link name="base_link">
    <visual><geometry><box size="0.28 0.22 0.07"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="0.28 0.22 0.07"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.006" iyy="0.008" izz="0.01"
      ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="left_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    <inertial><mass value="0.15"/><inertia ixx="0.0005" iyy="0.0005" izz="0.0005"
      ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <link name="right_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    <inertial><mass value="0.15"/><inertia ixx="0.0005" iyy="0.0005" izz="0.0005"
      ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 ${wheel_separation/2} -0.035" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 -${wheel_separation/2} -0.035" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <link name="front_caster">
    <visual><geometry><sphere radius="0.025"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.025"/></geometry></collision>
    <inertial><mass value="0.04"/><inertia ixx="0.00001" iyy="0.00001" izz="0.00001"
      ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/><child link="front_caster"/><origin xyz="0.115 0 -0.06"/>
  </joint>
  <xacro:line_camera parent="base_link"/>

  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation><wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id><odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
